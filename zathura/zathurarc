# zathura
# Colors live in the theme files next to this one. Swap the include below, or
# run `zathura/scripts/zt light` / `zt dark` to rewrite it. zathura reads its
# config only at startup, so a switch takes effect on the next launch.

include slate-light

# --- behavior --------------------------------------------------------------
set selection-clipboard  clipboard
set adjust-open          width
set scroll-step          60
set guioptions           ""
set window-title-basename true
set statusbar-home-tilde  true
