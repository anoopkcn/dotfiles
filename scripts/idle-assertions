#!/bin/sh
# What is keeping this machine awake? The rough equivalent of macOS's
# `pmset -g assertions`.
#
# Three independent mechanisms can veto an idle action, and hypridle honours all
# three — but it only ever logs a COUNT of held locks, never the holder. That
# gap is why a background Chrome tab holding a "Video Wake Lock" once kept the
# external monitor lit indefinitely and took a journal dig to find. This pulls
# the three sources together and names names.

section() {
    printf '\n== %s ==\n' "$1"
    if [ -n "$2" ]; then printf '%s\n' "$2" | sed 's/^/  /'; else echo "  none"; fi
}

# Only logged while something is actually holding one; silence means none.
section "hypridle: locks currently held" "$(
    journalctl --user -u hypridle -n 500 --no-pager 2>/dev/null \
        | grep -E 'Inhibit locks:|inhibit active' | tail -5
)"

# Browsers and Steam use this one. hypridle logs the requesting name and owner.
section "D-Bus org.freedesktop.ScreenSaver inhibits, last 6h" "$(
    journalctl --user -u hypridle --since -6h --no-pager 2>/dev/null \
        | grep 'ScreenSaver inhibit' | tail -10
)"

section "systemd inhibitors" "$(systemd-inhibit --list --no-pager 2>/dev/null)"

section "fullscreen windows (Wayland idle-inhibit, via conf/rules.lua)" "$(
    command -v jq >/dev/null 2>&1 && hyprctl clients -j 2>/dev/null \
        | jq -r '.[] | select(.fullscreen != 0) | "\(.class): \(.title)"'
)"
