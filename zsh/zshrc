# ~/.zshrc config

setopt extended_glob null_glob
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
path=(
    /Users/akc/.local/bin
    /Library/TeX/texbin
    $path
)
typeset -U path
path=($^path(N-/))
export PATH
export EDITOR='nvim'
export VIRTUAL_ENV_DISABLE_PROMPT=1
export CONDA_CHANGEPS1=no

bindkey -e

HISTFILE=$HOME/.zsh_history
HISTSIZE=10000
SAVEHIST=$HISTSIZE
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY

source_file() {  [ -f "$1" ] && source "$1"  }
path() { echo -e ${PATH//:/\\n} }

source_file $HOME/.privaterc
source_file "${ZDOTDIR:-$HOME/.config/zsh}/plugin-manager.sh"
source_file "${ZDOTDIR:-$HOME/.config/zsh}/minimal-prompt.sh"
source_file "${ZDOTDIR:-$HOME/.config/zsh}/fzf.sh"

alias duh="du -h -d 0 [^.]*"
alias notes="cd ~/Dropbox/notes"
alias ls="ls --color"
alias ll='eza --hyperlink'
alias icat="kitten icat"
alias vim="nvim"

plugin add "zshzoo/macos"
plugin add "zsh-users/zsh-syntax-highlighting"
plugin add "anoopkcn/zig-shell-completions"

autoload -Uz compinit && compinit
if [ -n "$ZSH_VERSION" ]; then
    zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

fi

autoload -U edit-command-line
zle -N edit-command-line
bindkey '^Xe' edit-command-line
export BAT_THEME="slate"


zo() {
    local target="${1:-.}"
    local script
    script="$(zenv activate "$target")" || return
    source "$script"
}

export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
export PWCLI="$CODEX_HOME/skills/playwright/scripts/playwright_cli.sh"

eval "$(zenv hook zsh)"
source "$HOME/.cargo/env" 
source <(fzf --zsh)
