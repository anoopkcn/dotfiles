doi2bib() {
  local doi="" info="" file=""
  local api="https://api.crossref.org/works" trans="transform/application/x-bibtex"
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        echo "usage: doi2bib -d DOI [-i FIELD | -f FILE]"
        return 0 ;;
      -d|--doi)  doi=${2-};  shift ;;
      -i|--info) info=${2-}; shift ;;
      -f|--file) file=${2-}; shift ;;
      *) echo "doi2bib: unknown option $1" >&2; return 1 ;;
    esac
    [ $# -gt 0 ] && shift
  done
  if [ -z "$doi" ]; then
    echo "doi2bib: no DOI given, use -d DOI" >&2; return 1
  fi

  local bib
  bib=$(curl -sfL "$api/$doi/$trans") || {
    echo "doi2bib: crossref has no BibTeX for $doi" >&2; return 1
  }

  if [ -n "$file" ]; then
    printf '\n%s\n' "$bib" >> "$file"
  elif [ -n "$info" ]; then
    grep -oE "$info=(\{[^}]*\}|[^,} ]*)" <<< "$bib"
  else
    printf '%s\n' "$bib"
  fi
}

