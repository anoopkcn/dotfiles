#!/usr/bin/env bash
# Pick an open Rex session or a project directory with fzf, then switch the Rex
# app to it, creating a session for a project if needed. A Rex take on the
# tmux-sessionizer idea. Tab and Shift-Tab switch between this machine and the
# hosts in `rex hosts`.
#
# Usage: rex-sessionizer [--client CLIENT] [DIR]
#   --client  Rex app to switch (the init.lua action passes the one that ran it)
#   DIR       skip the picker and use DIR on this machine
# fzf calls the script back with --cycle N, and that with --rows when needed.

set -euo pipefail

# Rex starts this from a login shell that skips ~/.zshrc, so fzf, jq and rex
# may not be on PATH yet. Rex's own bin dir first, so no other `rex` wins.
PATH="${REX_BIN_DIR:+$REX_BIN_DIR:}/opt/homebrew/bin:$PATH"

# Builtins only: dirname, basename and $(cd; pwd) cost about 8 ms per run.
self=${BASH_SOURCE[0]}
[[ $self == /* ]] || self=$PWD/$self

# Every directory directly under a root is a candidate project; nothing deeper
# is searched. To list the folders inside a grouping folder, add it as a root.
roots=(~/develop ~/develop/thirdparty ~/develop/agents-on-hpc ~/work ~/Dropbox ~/Dropbox/projects)
# Quoted on purpose: list_dir expands ~ on the other host.
# shellcheck disable=SC2088
remote_roots=('~/develop' '~/develop/thirdparty' '~/develop/agents-on-hpc' '~/work' '~/Dropbox' '~/Dropbox/projects')

# Between runs, the project list and the host table are kept in the cache dir
# and used at once; each run refreshes them in the background for the next one.
# Folders and hosts rarely change, and sessions are always fetched fresh.
cache=${XDG_CACHE_HOME:-$HOME/.cache}/rex-sessionizer

# State for one run, shared with the callbacks fzf runs:
#   hosts       "label|name|color" per host; the label is empty for
#               this machine
#   idx         the host shown now, counted from 0
#   rows.N      host N's rows, complete once rows.N.done exists
# The callbacks use only shell builtins where they can: each extra process
# costs a few milliseconds on macOS, and they run on every Tab.
state=${RS_STATE:-}

current() { local i; read -r i < "$state/idx"; echo "$i"; }

# "akc@idli" -> "Idli"; this machine -> its own name. A color slot (2-6)
# derived from the name, so each machine keeps its color.
host_entry() {
    local n=${1#*@}
    [[ -n $1 ]] || n=$(uname -n)
    n=${n%%.*}
    n=$(printf '%s' "${n:0:1}" | tr '[:lower:]' '[:upper:]')${n:1}
    printf '%s|%s|%s\n' "$1" "$n" $(( $(printf '%s' "$n" | cksum | cut -d' ' -f1) % 5 + 2 ))
}

# "Sessions on" and every host: the shown one as a colored badge, others dim.
# Shown as the label of the top border, the only fzf heading that starts at
# column 0 (--header is indented to line up with the list text).
heading() {
    local cur i=0 label name color part out="Sessions on "
    read -r cur < "$state/idx"
    while IFS='|' read -r label name color; do
        if [[ $i == "$cur" ]]; then
            printf -v part '\033[1;7;3%sm %s \033[0m' "$color" "$name"
        else
            printf -v part '\033[90m %s \033[0m' "$name"
        fi
        out+=$part
        i=$((i + 1))
    done < "$state/hosts"
    if (( i > 1 )); then out+=$'  \033[90mtab: switch\033[0m'; fi
    printf '%s \n' "$out"  # a space before the border line continues
}

# "S<TAB>id<TAB>label" per open session in `rex ls --json` output on stdin,
# leaving out the one this picker runs in.
list_sessions() {
    jq -r --arg cur "${REX_SESSION-}" \
        '.sessions[] | select(.session_id != $cur) | "S\t\(.session_id)\t\(.label // "")"'
}

# "P<TAB>dir" per project directory on this machine.
list_projects() {
    local r
    # Roots in the order given, each sorted ignoring case (the C and glibc
    # locales disagree on case).
    # Unreadable dirs make find fail; with pipefail that would discard the pick.
    # -H: a root may be a symlink (~/Dropbox on macOS), which find would not enter.
    for r in "${roots[@]}"; do
        [[ -d $r ]] || continue
        find -H "$r" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null |
            LC_ALL=C sort -f || true
    done | awk '{ print "P\t" $0 }'
}

# "P<TAB>dir" per project directory on host $1 with first session $2, read
# through the list_dir method of a terminal there, so it needs an open session.
# Prints "H<TAB>home" first. The roots are listed in parallel, into files named
# by the host's index $3. Short timeouts: a stuck host must not hold up Tab.
list_remote_projects() {
    local block i=0 r pids=()
    block=$(rex -S "$1" --timeout 2s block ls -s "$2" --json |
        jq -r 'first(.. | objects | select(.creator_name? == "com.superlogical.terminal") | .block_id) // empty')
    [[ -n $block ]] || return 0
    for r in "${remote_roots[@]}"; do
        rex -S "$1" --timeout 2s block call -s "$2" -b "$block" list_dir "$(jq -nc --arg p "$r" '{path: $p}')" \
            > "$state/ls.$3.$i" 2>/dev/null &
        pids+=($!)
        i=$((i + 1))
    done
    wait "${pids[@]}"
    # list_dir includes hidden directories, which the local find leaves out.
    for (( r = 0; r < i; r++ )); do
        jq -r 'select(.status == "ok")
               | "H\t\(.home)",
                 (.path as $p | [.entries[].name | select(startswith(".") | not)]
                  | sort_by(ascii_downcase)[] | "P\t\($p)/\(.)")' \
            "$state/ls.$3.$r" 2>/dev/null || true
    done
}

# One row per entry: a green dot for an open session, the name, then the parent
# directory dimmed. The key before the tab is "<host>|session:<id>" for a
# session and "<host>|dir:<label>|<path>" for a project. Open sessions come
# first; a project whose session is open shares its row.
#
# Each project gets a session label unique on its host: the folder name with
# . as _ (as before, so existing sessions still match); when two folders share
# that name, "<parent>/<name>" (develop/foo, work/foo); if that clashes too,
# the ~ path. A session named plain "foo" then claims neither folder.
# Plain awk, since macOS ships bash 3.2 without assoc arrays. LC_ALL=C makes
# BSD awk and gawk both count bytes; clen() then skips UTF-8 continuation bytes
# so names with accents still line up (wide CJK characters stay off by one).
format_rows() {
    LC_ALL=C awk -F'\t' -v home="$HOME" -v host="$1" '
        function clen(s,   i, n, c) {
            for (i = 1; i <= length(s); i++) { c = substr(s, i, 1); if (!(c >= "\200" && c < "\300")) n++ }
            return n
        }
        function pad(s,   n) { n = w - clen(s); return n > 0 ? s sprintf("%" n "s", "") : s }
        function row(key, mark, name, where) {
            printf "%s|%s\t%s %s  \033[90m%s\033[0m\n", host, key, mark, pad(name), where
        }
        $1 == "H" { home = $2; next }
        $1 == "S" { ns++; sid[ns] = $2; slabel[ns] = $3; open[$3] = 1; next }
        $1 == "P" && !seen[$2]++ {
            np++; dir = $2; n = split(dir, part, "/"); name = part[n]
            parent = substr(dir, 1, length(dir) - length(name) - 1)
            m = split(parent, pp, "/"); pbase = pp[m]
            if (index(parent "/", home "/") == 1) parent = "~" substr(parent, length(home) + 1)
            key = name; gsub(/\./, "_", key); gsub(/\./, "_", pbase)
            pdir[np] = dir; pname[np] = name; ppar[np] = parent
            pkey[np] = key; pkey2[np] = pbase "/" key
            count[key]++
        }
        END {
            for (i = 1; i <= np; i++) {
                l = pkey[i]
                if (count[l] > 1) { l = pkey2[i]; count2[l]++ }
                plabel[i] = l
            }
            for (i = 1; i <= np; i++) {
                if (count[pkey[i]] > 1 && count2[plabel[i]] > 1) plabel[i] = ppar[i] "/" pname[i]
                gsub(/\|/, "_", plabel[i])  # | separates the key fields
                if (!(plabel[i] in by_label)) by_label[plabel[i]] = i
            }
            for (i = 1; i <= np; i++) if (clen(pname[i]) > w) w = clen(pname[i])
            for (i = 1; i <= ns; i++) if (clen(slabel[i]) > w) w = clen(slabel[i])
            if (w > 32) w = 32
            dot = "\033[32m●\033[0m"
            for (i = 1; i <= ns; i++) {
                l = slabel[i]
                if (l in by_label) { j = by_label[l]; row(sid[i], dot, pname[j], ppar[j]) }
                else row(sid[i], dot, l, "session")
            }
            for (i = 1; i <= np; i++)
                if (!(plabel[i] in open)) row("dir:" plabel[i] "|" pdir[i], " ", pname[i], ppar[i])
        }'
}

# A dim row with an empty key, so Enter on it does nothing but close the picker.
note_row() { printf '%s|\t  \033[90m%s\033[0m\n' "$1" "$2"; }

# Rows of host label $1 (empty for this machine) with index $2 and display
# name $3, fetched now.
fetch_rows() {
    local h=$1 sessions sid
    if [[ -z $h ]]; then
        { rex ls --json | list_sessions; cached projects list_projects; } | format_rows ""
    elif ! sessions=$(rex -S "$h" --timeout 2s ls --json 2>/dev/null); then
        note_row "$h" "cannot reach $3"
    else
        sid=$(jq -r '.sessions[0].session_id // empty' <<< "$sessions")
        {
            list_sessions <<< "$sessions"
            [[ -z $sid ]] || list_remote_projects "$h" "$sid" "$2"
        } | format_rows "$h"
        if [[ -z $sid ]]; then note_row "$h" "no session on $3: open one there to list its projects"; fi
    fi
}

# Fetch host N's rows into the state dir, marking them complete.
prefetch() {
    local label name rest
    IFS='|' read -r label name rest < <(sed -n "$(( $1 + 1 ))p" "$state/hosts")
    fetch_rows "$label" "$1" "$name" > "$state/rows.$1" 2>/dev/null || true
    : > "$state/rows.$1.done"
}

# Rows of the host shown now, waiting (up to about 5 s) for its prefetch.
rows() {
    local i n=0 label name rest
    i=$(current)
    while [[ ! -e $state/rows.$i.done ]] && (( n++ < 100 )); do sleep 0.05; done
    if [[ -e $state/rows.$i.done ]]; then
        cat "$state/rows.$i" 2>/dev/null || true
    else
        IFS='|' read -r label name rest < <(sed -n "$(( i + 1 ))p" "$state/hosts")
        note_row "$label" "still loading $name: press Tab to come back"
    fi
}

# "label|name|color" for this machine and each host in `rex hosts`.
hosts_table() {
    host_entry ""
    rex hosts --json 2>/dev/null | jq -r '.hosts[].host.label' | while IFS= read -r h; do
        host_entry "$h"
    done || true
}

# Print cache file $1, or on the first run produce it with command $2 and keep it.
cached() {
    if [[ -s $cache/$1 ]]; then
        cat "$cache/$1"
    else
        mkdir -p "$cache"
        "$2" | tee "$cache/$1.$$"
        mv -f "$cache/$1.$$" "$cache/$1"
    fi
}

# Rebuild the cache for the next run; a rename keeps a reader from seeing half.
refresh_cache() {
    mkdir -p "$cache"
    list_projects > "$cache/projects.$$" && mv -f "$cache/projects.$$" "$cache/projects"
    hosts_table > "$cache/hosts.$$" && mv -f "$cache/hosts.$$" "$cache/hosts"
}

case ${1-} in
--refresh-cache) refresh_cache; exit ;;
--rows) rows; exit ;;
--cycle)
    # Moves to the next host and prints the fzf actions that show it, so one
    # callback per Tab does what three did (each costs a shell and this script).
    n=0
    while IFS= read -r _; do n=$((n + 1)); done < "$state/hosts"
    read -r i < "$state/idx"
    i=$(( ( i + $2 + n ) % n ))
    # Write then rename: a held Tab must not let a callback read a half-written file.
    echo "$i" > "$state/idx.$$"
    mv -f "$state/idx.$$" "$state/idx"
    # Rows already in: a plain cat. Otherwise --rows waits for them.
    # reload-sync keeps the current list until the new rows are in.
    if [[ -e $state/rows.$i.done ]]; then
        printf -v reload 'cat %q' "$state/rows.$i"
    else
        printf -v reload '%q --rows' "$self"
    fi
    # The label goes last in the ":" form, which runs to the end of the string,
    # so a ")" in a host name cannot end it early.
    printf 'reload-sync(%s)+first+change-border-label:%s' "$reload" "$(heading)"
    exit ;;
esac

client=""
if [[ ${1-} == --client ]]; then
    client=$2
    shift 2
fi

# Report a failure. The picker's pane closes when the script ends, so there
# the message waits for a key; run by hand, it just exits.
picker=""
fail() {
    printf '\n  \033[31m%s\033[0m\n' "$*" >&2
    if [[ -n $picker ]]; then
        printf '\n  press any key to close' >&2
        read -rsn1 < /dev/tty || true
    fi
    exit 1
}

# Switch the app to session $2 on host $1 (empty for this machine). The request
# has to go through the server that owns the session. The client ID comes from
# the server that ran the action, so other servers know the app by its label;
# without -C, rex picks the app itself when exactly one is connected.
# shellcheck disable=SC1010  # `do` is a rex subcommand here, not shell syntax
switch_to() {
    local rx=(rex) label=""
    [[ -n $1 ]] && rx=(rex -S "$1")
    if [[ -n $client ]]; then
        if [[ -z $1 ]] && rex -C "$client" do session.select session_id="$2" 2>/dev/null; then
            return
        fi
        # || true: a failed lookup must still reach the fallback below.
        label=$(rex client ls --json 2>/dev/null |
            jq -r --arg id "$client" '.clients[] | select(.client_id == $id) | .info.label // empty') || true
    fi
    if [[ -n $label ]] && "${rx[@]}" -C "$label" do session.select session_id="$2" 2>/dev/null; then
        return
    fi
    local err
    err=$("${rx[@]}" do session.select session_id="$2" 2>&1 > /dev/null) ||
        fail "could not switch to $2${1:+ on $1}: ${err:-no reason given}"
}

if [[ $# -ge 1 ]]; then
    dir=$(cd "$1" && pwd)
    selected="|dir:$(basename "$dir" | tr '.|' '__')|$dir"
else
    RS_STATE=$(mktemp -d "${TMPDIR:-/tmp}/rex-sessionizer.XXXXXX")
    state=$RS_STATE
    export RS_STATE
    trap 'kill $(jobs -p) 2>/dev/null || true; rm -rf "$RS_STATE"' EXIT
    # Closing the pane signals the script; exit so the EXIT trap still runs.
    trap 'exit 130' HUP INT TERM
    cached hosts hosts_table > "$state/hosts"
    echo 0 > "$state/idx"

    # Other hosts load in the background while this machine's list is shown,
    # so Tab usually finds them ready. Each run fetches afresh.
    n=0
    while IFS= read -r _; do
        if (( n > 0 )); then prefetch "$n" < /dev/null & fi
        n=$((n + 1))
    done < "$state/hosts"
    prefetch 0
    # Outside the job list, so closing the picker does not stop it.
    nohup nice "$self" --refresh-cache > /dev/null 2>&1 < /dev/null &
    disown

    q=$(printf '%q' "$self")
    printf '\033]2;Sessions\007'
    # Only ANSI palette slots, so the picker follows whichever Rex theme is
    # active. No background bar: no single slot is a readable bar in every
    # theme, so the current line is marked by the pointer and blue bold text.
    # --sync draws once the whole list is in, not an empty list that fills later.
    picker=1
    selected=$(rows | fzf --border=top --border-label="$(heading)" --border-label-pos=1 \
        --reverse --prompt='❯ ' --pointer='▌' --gutter=' ' --info=inline-right --sync \
        --color='16,fg:-1,bg:-1,bg+:-1,fg+:4:bold,hl:4,hl+:4:bold:underline' \
        --color='pointer:4,prompt:4,query:-1:bold,info:8,separator:8,scrollbar:8,border:8,label:-1' \
        --ansi --delimiter=$'\t' --with-nth=2 --accept-nth=1 \
        --bind="tab:transform($q --cycle 1)" \
        --bind="shift-tab:transform($q --cycle -1)") || exit 0
fi

host=${selected%%|*}
key=${selected#*|}
[[ -n $key ]] || exit 0

if [[ $key == session:* ]]; then
    switch_to "$host" "$key"
    exit 0
fi

[[ $key == dir:* ]] || exit 0
key=${key#dir:}
name=${key%%|*}  # the label format_rows chose for this folder
key=${key#*|}    # the folder; it may itself contain |
rx=(rex)
[[ -n $host ]] && rx=(rex -S "$host")

where=${host:-this machine}
# Reuse a session with the same label; Rex does not enforce unique labels.
# The picker already shows a project with an open session as that session,
# so only a DIR argument needs the lookup.
session_id=""
if [[ -z $picker ]]; then
    sessions=$("${rx[@]}" ls --json 2>&1) || fail "could not list sessions on $where: $sessions"
    session_id=$(jq -r --arg n "$name" \
        'first(.sessions[] | select(.label == $n) | .session_id) // empty' <<< "$sessions")
fi

if [[ -z $session_id ]]; then
    created=$("${rx[@]}" new "$name" -c "$key" --json 2>&1) ||
        fail "could not create session $name in $key on $where: $created"
    session_id=$(jq -er '.session_id' <<< "$created") ||
        fail "rex new gave no session id: $created"
fi

switch_to "$host" "$session_id"
