#!/usr/bin/env bash
# Helper for the session picker in init.lua, a Rex take on the tmux-sessionizer
# idea: it lists open sessions and project folders on this machine and the
# hosts in `rex hosts`, and switches the Rex app to the one picked.
#
# Usage:
#   rex-sessionizer list [SESSION]             every host's rows, as JSON
#                                              items for rex.ui.pick; other
#                                              hosts' rows come from the cache
#   rex-sessionizer open [--client CLIENT] KEY switch to the row KEY, making a
#                                              session for a project if needed
#   rex-sessionizer refresh                    rebuild the cache, including
#                                              other hosts' rows, for next time
# SESSION is the session to mark current, and CLIENT the Rex app to switch;
# the action passes both, since the server runs this without REX_SESSION.

set -euo pipefail

# The server runs this without REX_BIN_DIR or a rex on PATH; on macOS the CLI
# ships inside the server app.
PATH="${REX_BIN_DIR:+$REX_BIN_DIR:}/opt/homebrew/bin:$PATH"
if ! command -v rex > /dev/null; then
    PATH=$PATH:"$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS"
fi

# Every directory directly under a root is a candidate project; nothing deeper
# is searched. To list the folders inside a grouping folder, add it as a root.
roots=(~/develop ~/develop/thirdparty ~/develop/agents-on-hpc ~/work ~/Dropbox ~/Dropbox/projects)
# Quoted on purpose: list_dir expands ~ on the other host.
# shellcheck disable=SC2088
remote_roots=('~/develop' '~/develop/thirdparty' '~/develop/agents-on-hpc' '~/work' '~/Dropbox' '~/Dropbox/projects')

# The project list, the host table and the other hosts' rows are kept here
# and used at once; the action runs `refresh` after each list. This machine's
# sessions are always fetched fresh.
cache=${XDG_CACHE_HOME:-$HOME/.cache}/rex-sessionizer

# Scratch files for one run's parallel fetches.
state=""

make_state() {
    state=$(mktemp -d "${TMPDIR:-/tmp}/rex-sessionizer.XXXXXX")
    trap 'kill $(jobs -p) 2>/dev/null || true; rm -rf "$state"' EXIT
}

fail() {
    printf '%s\n' "$*" >&2
    exit 1
}

# "label|name" for host label $1 (empty for this machine): "akc@idli" -> "Idli".
host_entry() {
    local n=${1#*@}
    [[ -n $1 ]] || n=$(uname -n)
    n=${n%%.*}
    printf '%s|%s\n' "$1" "$(printf '%s' "${n:0:1}" | tr '[:lower:]' '[:upper:]')${n:1}"
}

# "label|name" for this machine and each host in `rex hosts`.
hosts_table() {
    host_entry ""
    rex hosts --json 2>/dev/null | jq -r '.hosts[].host.label' | while IFS= read -r h; do
        host_entry "$h"
    done || true
}

# "S<TAB>id<TAB>label<TAB>current" per open session in `rex ls --json` output
# on stdin; current is 1 for REX_SESSION.
list_sessions() {
    jq -r --arg cur "${REX_SESSION-}" \
        '.sessions[] | "S\t\(.session_id)\t\(.label // "")\t\(if .session_id == $cur then 1 else 0 end)"'
}

# "T<TAB>id<TAB>tabs" per open session in `rex ls --json` output on stdin, on
# host $1 (empty for this machine). `rex ls` gives no tab counts, so this runs
# one `session inspect` per session, in parallel, into files named by the
# host's index $2. A session that fails to answer just shows no count.
session_tabs() {
    local id i=0 k pids=() rx=(rex --timeout 2s)
    [[ -n $1 ]] && rx=(rex -S "$1" --timeout 2s)
    while IFS= read -r id; do
        "${rx[@]}" session inspect "$id" --json > "$state/tabs.$2.$i" 2> /dev/null &
        pids+=($!)
        i=$((i + 1))
    done < <(jq -r '.sessions[].session_id')
    (( i > 0 )) || return 0
    wait "${pids[@]}" || true
    for (( k = 0; k < i; k++ )); do cat "$state/tabs.$2.$k"; done |
        jq -r '"T\t\(.session_id)\t\(.windows | length)"' 2> /dev/null || true
}

# "P<TAB>dir" per project directory on this machine, the roots in order, each
# sorted ignoring case. -H: a root may be a symlink (~/Dropbox on macOS).
list_projects() {
    local r
    for r in "${roots[@]}"; do
        [[ -d $r ]] || continue
        find -H "$r" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null |
            LC_ALL=C sort -f || true
    done | awk '{ print "P\t" $0 }'
}

# "P<TAB>dir" per project directory on host $1 with first session $2, read
# through the list_dir method of a terminal there, so it needs an open session.
# Prints "H<TAB>home" first. The roots are listed in parallel, into files named
# by the host's index $3. Short timeouts: a stuck host must not hold up the list.
list_remote_projects() {
    local block i=0 r pids=()
    block=$(rex -S "$1" --timeout 2s block ls -s "$2" --json |
        jq -r 'first(.. | objects | select(.creator_name? == "com.superlogical.terminal") | .block_id) // empty')
    [[ -n $block ]] || return 0
    for r in "${remote_roots[@]}"; do
        rex -S "$1" --timeout 2s block call -s "$2" -b "$block" list_dir "$(jq -nc --arg p "$r" '{path: $p}')" \
            > "$state/ls.$3.$i" 2>/dev/null &
        pids+=($!)
        i=$((i + 1))
    done
    wait "${pids[@]}"
    # list_dir includes hidden directories, which the local find leaves out.
    for (( r = 0; r < i; r++ )); do
        jq -r 'select(.status == "ok")
               | "H\t\(.home)",
                 (.path as $p | [.entries[].name | select(startswith(".") | not)]
                  | sort_by(ascii_downcase)[] | "P\t\($p)/\(.)")' \
            "$state/ls.$3.$r" 2>/dev/null || true
    done
}

# Rows "key<TAB>icon<TAB>title<TAB>subtitle<TAB>host name" for host label $1
# and name $2, from the S, T, P and H lines above. The key is
# "<host>|session:<id>" for a session and "<host>|dir:<label>|<path>" for a
# project; a project whose session is open is shown only as that session.
#
# Each project gets a session label unique on its host: the folder name with
# . as _ (as before, so existing sessions still match); when two folders share
# that name, "<parent>/<name>" (develop/foo, work/foo); if that clashes too,
# the ~ path. A session named plain "foo" then claims neither folder.
# Plain awk, since macOS ships bash 3.2 without assoc arrays.
format_rows() {
    awk -F'\t' -v home="$HOME" -v host="$1" -v hname="$2" '
        function row(key, icon, title, subtitle) {
            printf "%s|%s\t%s\t%s\t%s\t%s\n", host, key, icon, title, subtitle, hname
        }
        $1 == "H" { home = $2; next }
        $1 == "S" { ns++; sid[ns] = $2; slabel[ns] = $3; scur[ns] = $4; open[$3] = 1; next }
        $1 == "T" { tabs[$2] = $3; next }
        $1 == "P" && !seen[$2]++ {
            np++; dir = $2; n = split(dir, part, "/"); name = part[n]
            parent = substr(dir, 1, length(dir) - length(name) - 1)
            m = split(parent, pp, "/"); pbase = pp[m]
            if (index(parent "/", home "/") == 1) parent = "~" substr(parent, length(home) + 1)
            key = name; gsub(/\./, "_", key); gsub(/\./, "_", pbase)
            pdir[np] = dir; pname[np] = name; ppar[np] = parent
            pkey[np] = key; pkey2[np] = pbase "/" key
            count[key]++
        }
        END {
            for (i = 1; i <= np; i++) {
                l = pkey[i]
                if (count[l] > 1) { l = pkey2[i]; count2[l]++ }
                plabel[i] = l
            }
            for (i = 1; i <= np; i++) {
                if (count[pkey[i]] > 1 && count2[plabel[i]] > 1) plabel[i] = ppar[i] "/" pname[i]
                gsub(/\|/, "_", plabel[i])  # | separates the key fields
                if (!(plabel[i] in by_label)) by_label[plabel[i]] = i
            }
            for (i = 1; i <= ns; i++) {
                l = slabel[i]; t = tabs[sid[i]]
                if (t != "") t = t (t == 1 ? " tab" : " tabs")
                if (scur[i]) t = (t != "" ? t ", " : "") "current"
                row(sid[i], "terminal", (l in by_label) ? pname[by_label[l]] : (l != "" ? l : "unnamed session"), t)
            }
            for (i = 1; i <= np; i++)
                if (!(plabel[i] in open)) row("dir:" plabel[i] "|" pdir[i], "folder", pname[i], ppar[i])
        }'
}

# A row with an empty key, which `open` ignores.
note_row() { printf '%s|\tserver\t%s\t\t\n' "$1" "$2"; }

# Rows of host label $1 (empty for this machine) with index $2 and name $3.
fetch_rows() {
    local h=$1 sessions sid
    if [[ -z $h ]]; then
        sessions=$(rex ls --json)
        {
            list_sessions <<< "$sessions"
            session_tabs "" "$2" <<< "$sessions"
            cached projects list_projects
        } | format_rows "" "$3"
    elif ! sessions=$(rex -S "$h" --timeout 2s ls --json 2>/dev/null); then
        note_row "$h" "cannot reach $3"
    else
        sid=$(jq -r '.sessions[0].session_id // empty' <<< "$sessions")
        {
            list_sessions <<< "$sessions"
            session_tabs "$h" "$2" <<< "$sessions"
            [[ -z $sid ]] || list_remote_projects "$h" "$sid" "$2"
        } | format_rows "$h" "$3"
        if [[ -z $sid ]]; then note_row "$h" "no session on $3: open one there to list its projects"; fi
    fi
}

# Print cache file $1, or on the first run produce it with command $2 and keep it.
cached() {
    if [[ -s $cache/$1 ]]; then
        cat "$cache/$1"
    else
        mkdir -p "$cache"
        "$2" | tee "$cache/$1.$$"
        mv -f "$cache/$1.$$" "$cache/$1"
    fi
}

# Rows of the hosts in host table $1 after this machine, fetched in parallel.
remote_rows() {
    local n=0 i label name
    while IFS='|' read -r label name _; do
        if (( n > 0 )); then
            { fetch_rows "$label" "$n" "$name" || true; } > "$state/rows.$n" 2>/dev/null &
        fi
        n=$((n + 1))
    done < "$1"
    wait
    for (( i = 1; i < n; i++ )); do cat "$state/rows.$i"; done
}

# Rebuild the cache for the next run; a rename keeps a reader from seeing half.
cmd_refresh() {
    make_state
    mkdir -p "$cache"
    list_projects > "$cache/projects.$$" && mv -f "$cache/projects.$$" "$cache/projects"
    hosts_table > "$cache/hosts.$$" && mv -f "$cache/hosts.$$" "$cache/hosts"
    remote_rows "$cache/hosts" > "$cache/remote.$$" && mv -f "$cache/remote.$$" "$cache/remote"
}

# This machine's rows, fetched now, and the other hosts' rows as the last
# refresh left them, since a host that is down would hold the palette up for
# its whole timeout. One JSON list: open sessions first, then projects, then
# notes about hosts that failed. The host name goes in detail only when there
# is more than one host.
cmd_list() {
    [[ -z ${1-} ]] || REX_SESSION=$1
    make_state
    local hosts name
    hosts=$(cached hosts hosts_table)
    IFS='|' read -r _ name _ <<< "$hosts"
    {
        fetch_rows "" 0 "$name"
        cat "$cache/remote" 2>/dev/null || true
    } |
        jq -Rn --argjson hosts "$(grep -c . <<< "$hosts")" '
            [inputs | split("\t")
             | {id: .[0], icon: .[1], title: .[2], subtitle: .[3], detail: .[4]}
             | if $hosts == 1 then del(.detail) else . end
             | with_entries(select(.value != null and .value != ""))]
            | sort_by(if .icon == "terminal" then 0 elif .icon == "folder" then 1 else 2 end)'
}

# Switch the app to session $2 on host $1 (empty for this machine). The request
# has to go through the server that owns the session. The client ID comes from
# the server that ran the action, so other servers know the app by its label;
# without -C, rex picks the app itself when exactly one is connected.
# shellcheck disable=SC1010  # `do` is a rex subcommand here, not shell syntax
switch_to() {
    local rx=(rex) label="" err
    [[ -n $1 ]] && rx=(rex -S "$1")
    if [[ -n $client ]]; then
        if [[ -z $1 ]] && rex -C "$client" do session.select session_id="$2" 2>/dev/null; then
            return
        fi
        # || true: a failed lookup must still reach the fallback below.
        label=$(rex client ls --json 2>/dev/null |
            jq -r --arg id "$client" '.clients[] | select(.client_id == $id) | .info.label // empty') || true
    fi
    if [[ -n $label ]] && "${rx[@]}" -C "$label" do session.select session_id="$2" 2>/dev/null; then
        return
    fi
    err=$("${rx[@]}" do session.select session_id="$2" 2>&1 > /dev/null) ||
        fail "could not switch to $2${1:+ on $1}: ${err:-no reason given}"
}

client=""
cmd_open() {
    if [[ ${1-} == --client ]]; then
        client=$2
        shift 2
    fi
    [[ $# -eq 1 ]] || fail "usage: rex-sessionizer open [--client CLIENT] KEY"
    local host=${1%%|*} key=${1#*|} name dir where sessions session_id="" created rx=(rex)
    [[ -n $key ]] || return 0  # a note row
    if [[ $key == session:* ]]; then
        switch_to "$host" "$key"
        return
    fi
    [[ $key == dir:* ]] || fail "not a row key: $1"
    key=${key#dir:}
    name=${key%%|*}  # the label format_rows chose for this folder
    dir=${key#*|}    # the folder; it may itself contain |
    [[ -n $host ]] && rx=(rex -S "$host")
    where=${host:-this machine}
    # Rex would make a session in a folder that is gone (removed since the cache).
    [[ -n $host || -d $dir ]] || fail "no folder $dir on $where"

    # Reuse a session with the same label, in case one opened since the list;
    # Rex does not enforce unique labels.
    sessions=$("${rx[@]}" ls --json 2>&1) || fail "could not list sessions on $where: $sessions"
    session_id=$(jq -r --arg n "$name" \
        'first(.sessions[] | select(.label == $n) | .session_id) // empty' <<< "$sessions")
    if [[ -z $session_id ]]; then
        created=$("${rx[@]}" new "$name" -c "$dir" --json 2>&1) ||
            fail "could not create session $name in $dir on $where: $created"
        session_id=$(jq -er '.session_id' <<< "$created") ||
            fail "rex new gave no session id: $created"
    fi
    switch_to "$host" "$session_id"
}

case ${1-} in
list) shift; cmd_list "$@" ;;
open) shift; cmd_open "$@" ;;
refresh) cmd_refresh ;;
*) fail "usage: rex-sessionizer list [SESSION] | open [--client CLIENT] KEY | refresh" ;;
esac
